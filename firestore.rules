rules_version = '2';
// Firestore security rules — RACE_WEBAPP_LITE
// Publish from Firebase Console after testing. The UI is not an authorization boundary.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function caller() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return signedIn() && caller().role == 'admin';
    }

    function isApprovedRole(role) {
      return signedIn() && caller().approved == true && caller().role == role;
    }

    function isOwnTeam(team) {
      return int(team) == int(caller().team);
    }

    // Users register themselves as unapproved operator/evaluator accounts. Only an
    // admin may later approve them or change role/team; self-promotion is forbidden.
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow read: if isAdmin();

      allow create: if signedIn() && request.auth.uid == uid &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.approved == false &&
        request.resource.data.role in ['operator', 'evaluator'] &&
        request.resource.data.team is int &&
        request.resource.data.team >= 1 && request.resource.data.team <= 15;

      allow update: if signedIn() && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'email']);
      allow update, delete: if isAdmin();
    }

    // Race lifecycle is controlled by the team's commander (internal role:
    // operator). Evaluators may change only the shared evaluation payload (`tags`).
    // Arrival order is intentionally stored in a per-evaluator child document below.
    match /races/{raceId} {
      allow read: if isAdmin() ||
        (signedIn() && caller().approved == true && isOwnTeam(resource.data.team));

      allow create: if isAdmin() ||
        (isApprovedRole('operator') && isOwnTeam(request.resource.data.team) &&
         request.resource.data.keys()
           .hasOnly(['team', 'station', 'round', 'status', 'startedAt', 'startedBy', 'participantIds', 'tags', 'timeLimitSeconds']) &&
         request.resource.data.team is string && request.resource.data.station is string &&
         request.resource.data.status == 'running' &&
         request.resource.data.startedBy == request.auth.uid &&
         request.resource.data.startedAt == request.time &&
         request.resource.data.round is int && request.resource.data.round > 0 &&
         (!request.resource.data.keys().hasAny(['participantIds']) ||
           request.resource.data.participantIds is list) &&
         (!request.resource.data.keys().hasAny(['timeLimitSeconds']) ||
           (request.resource.data.timeLimitSeconds is int &&
            request.resource.data.timeLimitSeconds == 2400)) &&
         request.resource.data.tags is list && request.resource.data.tags.size() == 0);

      allow update: if isAdmin();

      // Commander: forward-only running -> stopped transition, without touching tags.
      allow update: if isApprovedRole('operator') && isOwnTeam(resource.data.team) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'endedAt', 'endedBy', 'endedReason']) &&
        resource.data.status == 'running' &&
        request.resource.data.status == 'stopped' &&
        request.resource.data.endedAt == request.time &&
        request.resource.data.endedAt >= resource.data.startedAt &&
        request.resource.data.endedBy == request.auth.uid &&
        (!request.resource.data.keys().hasAny(['endedReason']) ||
          request.resource.data.endedReason in ['manual', 'time_limit']);

      // Evaluator: may work on current or historical evaluations, but cannot alter
      // team/station/round or any timing/lifecycle field.
      allow update: if isApprovedRole('evaluator') && isOwnTeam(resource.data.team) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tags']);

      allow delete: if isAdmin();

      // Each evaluator owns one independent arrival-order document per round.
      // Keeping these documents separate prevents two evaluators from overwriting
      // one another and lets the rules enforce ownership directly.
      match /evaluatorArrivals/{evaluatorUid} {
        function parentRace() {
          return get(/databases/$(database)/documents/races/$(raceId)).data;
        }

        function ownsArrivalDocument() {
          return isApprovedRole('evaluator') &&
            request.auth.uid == evaluatorUid &&
            isOwnTeam(parentRace().team);
        }

        function validArrivalShape() {
          return request.resource.data.keys().hasAll([
              'evaluatorUid', 'participantIds', 'order', 'slotTimes',
              'schemaVersion', 'createdAt', 'updatedAt'
            ]) &&
            request.resource.data.keys().hasOnly([
              'evaluatorUid', 'participantIds', 'order', 'slotTimes',
              'schemaVersion', 'createdAt', 'updatedAt', 'completedAt'
            ]) &&
            request.resource.data.evaluatorUid == evaluatorUid &&
            request.resource.data.participantIds is list &&
            request.resource.data.order is list &&
            request.resource.data.slotTimes is map &&
            request.resource.data.order.size() <= request.resource.data.participantIds.size() &&
            request.resource.data.slotTimes.size() <= request.resource.data.participantIds.size() &&
            request.resource.data.schemaVersion == 1 &&
            request.resource.data.updatedAt == request.time &&
            (!request.resource.data.keys().hasAny(['completedAt']) ||
              request.resource.data.completedAt is timestamp);
        }

        allow read: if isAdmin() || ownsArrivalDocument();
        allow create: if isAdmin() ||
          (ownsArrivalDocument() && validArrivalShape() &&
           request.resource.data.createdAt == request.time);
        allow update: if isAdmin() ||
          (ownsArrivalDocument() && validArrivalShape() &&
           request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['order', 'slotTimes', 'completedAt', 'updatedAt']));
        allow delete: if isAdmin();
      }
    }

    // Teams (participants + station mapping): team members read, admins write.
    match /teams/{teamNumber} {
      allow read: if isAdmin() ||
        (signedIn() && caller().approved == true && int(teamNumber) == int(caller().team));
      allow write: if isAdmin();
    }

    // Shared station types and quick-comment settings.
    match /settings/{key} {
      allow read: if signedIn() && (caller().approved == true || isAdmin());
      allow write: if isAdmin();
    }

    // General notes use document IDs in the form "<team>_<participant>".
    match /general_notes/{noteId} {
      allow read: if isAdmin() ||
        (signedIn() && caller().approved == true &&
         int(noteId.split('_')[0]) == int(caller().team));
      allow write: if isAdmin();
      allow write: if signedIn() && caller().approved == true &&
        caller().role in ['operator', 'evaluator'] &&
        int(noteId.split('_')[0]) == int(caller().team);
    }

    // Operational issue reports contain only an allow-listed diagnostic context.
    // Reporters may create a report but cannot read or alter reports afterward;
    // administrators own triage and status updates.
    match /issue_reports/{reportId} {
      function validIssueContext() {
        return request.resource.data.context is map &&
          request.resource.data.context.keys().hasAll([
            'team', 'station', 'stationType', 'stationName', 'viewedRaceId',
            'latestRaceId', 'round', 'raceStatus', 'effectiveElapsedMs', 'historicalView'
          ]) &&
          request.resource.data.context.keys().hasOnly([
            'team', 'station', 'stationType', 'stationName', 'viewedRaceId',
            'latestRaceId', 'round', 'raceStatus', 'effectiveElapsedMs', 'historicalView'
          ]) &&
          request.resource.data.context.team is string &&
          request.resource.data.context.team.size() <= 200 &&
          request.resource.data.context.station is string &&
          request.resource.data.context.station.size() <= 200 &&
          request.resource.data.context.stationType is string &&
          request.resource.data.context.stationType.size() <= 200 &&
          request.resource.data.context.stationName is string &&
          request.resource.data.context.stationName.size() <= 200 &&
          request.resource.data.context.viewedRaceId is string &&
          request.resource.data.context.viewedRaceId.size() <= 200 &&
          request.resource.data.context.latestRaceId is string &&
          request.resource.data.context.latestRaceId.size() <= 200 &&
          request.resource.data.context.round is int &&
          request.resource.data.context.round >= 0 &&
          request.resource.data.context.raceStatus in ['not_started', 'running', 'stopped', 'time_limit'] &&
          request.resource.data.context.effectiveElapsedMs is int &&
          request.resource.data.context.effectiveElapsedMs >= 0 &&
          request.resource.data.context.effectiveElapsedMs <= 2400000 &&
          request.resource.data.context.historicalView is bool;
      }

      function validIssueEnvironment() {
        return request.resource.data.environment is map &&
          request.resource.data.environment.keys()
            .hasAll(['appVersion', 'online', 'viewport', 'userAgent']) &&
          request.resource.data.environment.keys()
            .hasOnly(['appVersion', 'online', 'viewport', 'userAgent']) &&
          request.resource.data.environment.appVersion is string &&
          request.resource.data.environment.appVersion.size() <= 100 &&
          request.resource.data.environment.online is bool &&
          request.resource.data.environment.viewport is string &&
          request.resource.data.environment.viewport.size() <= 50 &&
          request.resource.data.environment.userAgent is string &&
          request.resource.data.environment.userAgent.size() <= 500;
      }

      function validNewIssueReport() {
        return request.resource.data.keys().hasAll([
            'reporterUid', 'reporterName', 'reporterRole', 'reporterTeam',
            'category', 'description', 'steps', 'status', 'adminNote',
            'context', 'environment', 'schemaVersion', 'createdAt', 'updatedAt'
          ]) &&
          request.resource.data.keys().hasOnly([
            'reporterUid', 'reporterName', 'reporterRole', 'reporterTeam',
            'category', 'description', 'steps', 'status', 'adminNote',
            'context', 'environment', 'schemaVersion', 'createdAt', 'updatedAt'
          ]) &&
          request.resource.data.reporterUid == request.auth.uid &&
          request.resource.data.reporterName is string &&
          request.resource.data.reporterName.size() <= 200 &&
          request.resource.data.reporterRole == caller().role &&
          request.resource.data.reporterRole in ['operator', 'evaluator', 'admin'] &&
          request.resource.data.reporterTeam is int &&
          request.resource.data.reporterTeam >= 1 && request.resource.data.reporterTeam <= 15 &&
          (isAdmin() || request.resource.data.reporterTeam == int(caller().team)) &&
          request.resource.data.category in ['timing', 'arrival_order', 'saving', 'display', 'other'] &&
          request.resource.data.description is string &&
          request.resource.data.description.size() > 0 &&
          request.resource.data.description.size() <= 2000 &&
          request.resource.data.steps is string && request.resource.data.steps.size() <= 2000 &&
          request.resource.data.status == 'open' &&
          request.resource.data.adminNote == '' &&
          request.resource.data.schemaVersion == 1 &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.updatedAt == request.time &&
          validIssueContext() && validIssueEnvironment();
      }

      allow create: if signedIn() &&
        (isAdmin() || (caller().approved == true && caller().role in ['operator', 'evaluator'])) &&
        validNewIssueReport();
      allow read: if isAdmin();
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'adminNote', 'updatedAt', 'handledAt', 'handledBy']) &&
        request.resource.data.status in ['open', 'in_progress', 'resolved'] &&
        request.resource.data.adminNote is string &&
        request.resource.data.adminNote.size() <= 2000 &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.handledAt == request.time &&
        request.resource.data.handledBy == request.auth.uid;
      allow delete: if isAdmin();
    }
  }
}
