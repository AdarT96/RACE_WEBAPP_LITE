rules_version = '2';
// Firestore security rules — RACE_WEBAPP_LITE
// Publish from Firebase Console after testing. The UI is not an authorization boundary.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function caller() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return signedIn() && caller().role == 'admin';
    }

    function isApprovedRole(role) {
      return signedIn() && caller().approved == true && caller().role == role;
    }

    function isFormationCommander() {
      return isApprovedRole('formation_commander');
    }

    function isOwnTeam(team) {
      return int(team) == int(caller().team);
    }

    function isActiveEvent(eventId) {
      return exists(/databases/$(database)/documents/settings/activeEvent) &&
        get(/databases/$(database)/documents/settings/activeEvent).data.status == 'active' &&
        get(/databases/$(database)/documents/settings/activeEvent).data.eventId == eventId &&
        exists(/databases/$(database)/documents/events/$(eventId)) &&
        get(/databases/$(database)/documents/events/$(eventId)).data.status == 'active';
    }

    // The administrator sets this marker only after every legacy shared document
    // has been migrated. Until then the previous clients remain usable; from that
    // instant onward, private data can only be read from owner-scoped documents.
    function privacyMigrationComplete() {
      return exists(/databases/$(database)/documents/settings/evaluationPrivacy) &&
        get(/databases/$(database)/documents/settings/evaluationPrivacy).data.schemaVersion == 2 &&
        get(/databases/$(database)/documents/settings/evaluationPrivacy).data.status == 'complete';
    }

    // Users register themselves as unapproved operational accounts. Only an admin
    // may later approve them or change role/team; self-promotion is forbidden.
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow read: if isAdmin();

      allow create: if signedIn() && request.auth.uid == uid &&
        request.resource.data.keys().hasAll([
          'uid', 'name', 'email', 'role', 'team', 'approved', 'createdAt'
        ]) &&
        request.resource.data.keys().hasOnly([
          'uid', 'name', 'email', 'role', 'team', 'approved', 'createdAt'
        ]) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.name is string && request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 200 &&
        request.resource.data.email is string && request.resource.data.email.size() > 0 &&
        request.resource.data.email.size() <= 320 &&
        request.resource.data.approved == false &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.role in ['operator', 'evaluator', 'formation_commander'] &&
        ((request.resource.data.role in ['operator', 'evaluator'] &&
          request.resource.data.team is int &&
          request.resource.data.team >= 1 && request.resource.data.team <= 15) ||
         (request.resource.data.role == 'formation_commander' &&
          request.resource.data.team == null));

      allow update: if signedIn() && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'email']);
      allow update, delete: if isAdmin();
    }

    // Race documents contain lifecycle and roster data only in schema 2. Subjective
    // results live in an owner-scoped evaluatorAssessments child document.
    match /races/{raceId} {
      allow read: if isAdmin() ||
        (signedIn() && caller().approved == true && isOwnTeam(resource.data.team) &&
         (!privacyMigrationComplete() || resource.data.evaluationSchemaVersion == 2)) ||
        (isFormationCommander() && resource.data.evaluationSchemaVersion == 2 &&
         resource.data.eventId is string && isActiveEvent(resource.data.eventId));

      allow create: if isAdmin() ||
        (isApprovedRole('operator') && isOwnTeam(request.resource.data.team) &&
         request.resource.data.keys()
           .hasOnly(['eventId', 'team', 'station', 'round', 'status', 'startedAt', 'startedBy', 'participantIds', 'tags', 'timeLimitSeconds', 'evaluationSchemaVersion']) &&
         request.resource.data.keys().hasAll(['eventId', 'team', 'station', 'round', 'status', 'startedAt', 'startedBy', 'participantIds', 'tags']) &&
         request.resource.data.eventId is string && isActiveEvent(request.resource.data.eventId) &&
         request.resource.data.team is string && request.resource.data.station is string &&
         request.resource.data.status == 'running' &&
         request.resource.data.startedBy == request.auth.uid &&
         request.resource.data.startedAt == request.time &&
         request.resource.data.round is int && request.resource.data.round > 0 &&
         (!privacyMigrationComplete() || request.resource.data.evaluationSchemaVersion == 2) &&
         (!request.resource.data.keys().hasAny(['evaluationSchemaVersion']) ||
           request.resource.data.evaluationSchemaVersion == 2) &&
         (!request.resource.data.keys().hasAny(['participantIds']) ||
           (request.resource.data.participantIds is list &&
            request.resource.data.participantIds.size() <= 20)) &&
         (!request.resource.data.keys().hasAny(['timeLimitSeconds']) ||
           (request.resource.data.timeLimitSeconds is int &&
            request.resource.data.timeLimitSeconds == 2400)) &&
         request.resource.data.tags is list && request.resource.data.tags.size() == 0);

      allow update: if isAdmin();

      // Commander: forward-only running -> stopped transition, without touching tags.
      allow update: if isApprovedRole('operator') && isOwnTeam(resource.data.team) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'endedAt', 'endedBy', 'endedReason']) &&
        resource.data.status == 'running' &&
        request.resource.data.status == 'stopped' &&
        request.resource.data.endedAt == request.time &&
        request.resource.data.endedAt >= resource.data.startedAt &&
        request.resource.data.endedBy == request.auth.uid &&
        (!request.resource.data.keys().hasAny(['endedReason']) ||
          request.resource.data.endedReason in ['manual', 'time_limit']);

      // Compatibility is automatically disabled when the migration marker is set.
      // New clients never write evaluator data into the shared race document.
      allow update: if isApprovedRole('evaluator') && isOwnTeam(resource.data.team) &&
        !privacyMigrationComplete() &&
        (!resource.data.keys().hasAny(['evaluationSchemaVersion']) ||
          resource.data.evaluationSchemaVersion != 2) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tags']);

      allow delete: if isAdmin();

      // Each evaluator owns one independent arrival-order document per round.
      // Keeping these documents separate prevents two evaluators from overwriting
      // one another and lets the rules enforce ownership directly.
      match /evaluatorArrivals/{evaluatorUid} {
        function parentRace() {
          return get(/databases/$(database)/documents/races/$(raceId)).data;
        }

        function ownsArrivalDocument() {
          return isApprovedRole('evaluator') &&
            request.auth.uid == evaluatorUid &&
            isOwnTeam(parentRace().team);
        }

        function validArrivalShape() {
          return request.resource.data.keys().hasAll([
              'evaluatorUid', 'participantIds', 'order', 'slotTimes',
              'schemaVersion', 'createdAt', 'updatedAt'
            ]) &&
            request.resource.data.keys().hasOnly([
              'evaluatorUid', 'participantIds', 'order', 'slotTimes',
              'schemaVersion', 'createdAt', 'updatedAt', 'completedAt'
            ]) &&
            request.resource.data.evaluatorUid == evaluatorUid &&
            request.resource.data.participantIds is list &&
            request.resource.data.order is list &&
            request.resource.data.slotTimes is map &&
            request.resource.data.order.size() <= request.resource.data.participantIds.size() &&
            request.resource.data.slotTimes.size() <= request.resource.data.participantIds.size() &&
            request.resource.data.schemaVersion == 1 &&
            request.resource.data.updatedAt == request.time &&
            (!request.resource.data.keys().hasAny(['completedAt']) ||
              request.resource.data.completedAt is timestamp);
        }

        allow read: if isAdmin() || ownsArrivalDocument();
        allow create: if isAdmin() ||
          (ownsArrivalDocument() && validArrivalShape() &&
           request.resource.data.createdAt == request.time);
        allow update: if isAdmin() ||
          (ownsArrivalDocument() && validArrivalShape() &&
           request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['order', 'slotTimes', 'completedAt', 'updatedAt']));
        allow delete: if isAdmin();
      }

      // One private document per evaluator and round. Firestore rules cannot mask
      // individual fields, so ownership is enforced at the document path itself.
      match /evaluatorAssessments/{evaluatorUid} {
        function parentRace() {
          return get(/databases/$(database)/documents/races/$(raceId)).data;
        }

        function ownsAssessmentDocument() {
          return isApprovedRole('evaluator') &&
            request.auth.uid == evaluatorUid &&
            isOwnTeam(parentRace().team);
        }

        function validAssessmentShape() {
          return request.resource.data.keys().hasAll([
              'evaluatorUid', 'entries', 'schemaVersion', 'createdAt', 'updatedAt'
            ]) &&
            request.resource.data.keys().hasOnly([
              'evaluatorUid', 'entries', 'schemaVersion', 'createdAt', 'updatedAt'
            ]) &&
            request.resource.data.evaluatorUid == evaluatorUid &&
            request.resource.data.entries is map &&
            request.resource.data.entries.size() <= 20 &&
            request.resource.data.schemaVersion == 2 &&
            request.resource.data.updatedAt == request.time;
        }

        allow read: if isAdmin() || ownsAssessmentDocument();
        allow create: if isAdmin() ||
          (ownsAssessmentDocument() && validAssessmentShape() &&
           request.resource.data.createdAt == request.time);
        allow update: if isAdmin() ||
          (ownsAssessmentDocument() && validAssessmentShape() &&
           request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['entries', 'updatedAt']));
        allow delete: if isAdmin();
      }
    }

    // One immutable operational snapshot per formation event. Operational users
    // can read only the event/team data required for their role; only admins
    // create or close events.
    match /events/{eventId} {
      allow read: if isAdmin() || isFormationCommander() ||
        isApprovedRole('operator') || isApprovedRole('evaluator');
      allow create, update: if isAdmin();
      allow delete: if false;

      match /teams/{teamNumber} {
        allow read: if isAdmin() || isFormationCommander() ||
          ((isApprovedRole('operator') || isApprovedRole('evaluator')) && isOwnTeam(teamNumber));
        allow create, update: if isAdmin();
        allow delete: if false;
      }

      // The master schedule is visible only to formation management. Team staff
      // read a projection containing their own column, so the full formation
      // movement plan is never exposed as a side effect of opening the team view.
      function validMasterSchedule() {
        return request.resource.data.keys().hasAll([
            'eventId', 'teamIds', 'commanderNames', 'rows', 'loadPolicy',
            'loadWarnings', 'overrideReason', 'revision', 'revisionKey', 'schemaVersion', 'timeZone',
            'publicationType', 'restoredFromRevisionKey',
            'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
          ]) &&
          request.resource.data.keys().hasOnly([
            'eventId', 'teamIds', 'commanderNames', 'rows', 'loadPolicy',
            'loadWarnings', 'overrideReason', 'revision', 'revisionKey', 'schemaVersion', 'timeZone',
            'publicationType', 'restoredFromRevisionKey',
            'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
          ]) &&
          request.resource.data.eventId == eventId &&
          request.resource.data.teamIds is list && request.resource.data.teamIds.size() > 0 &&
          request.resource.data.teamIds.size() <= 15 &&
          request.resource.data.commanderNames is map && request.resource.data.commanderNames.size() <= 15 &&
          request.resource.data.rows is list && request.resource.data.rows.size() <= 100 &&
          request.resource.data.loadPolicy is map &&
          request.resource.data.loadPolicy.keys().hasAll([
            'windowMinutes', 'maxWindowLoad', 'highIntensity', 'maxConsecutiveHigh'
          ]) &&
          request.resource.data.loadPolicy.keys().hasOnly([
            'windowMinutes', 'maxWindowLoad', 'highIntensity', 'maxConsecutiveHigh'
          ]) &&
          request.resource.data.loadPolicy.windowMinutes is int &&
          request.resource.data.loadPolicy.windowMinutes >= 30 &&
          request.resource.data.loadPolicy.maxWindowLoad is int &&
          request.resource.data.loadPolicy.maxWindowLoad > 0 &&
          request.resource.data.loadPolicy.highIntensity is int &&
          request.resource.data.loadPolicy.highIntensity in [1, 2, 3] &&
          request.resource.data.loadPolicy.maxConsecutiveHigh is int &&
          request.resource.data.loadPolicy.maxConsecutiveHigh > 0 &&
          request.resource.data.loadWarnings is list && request.resource.data.loadWarnings.size() <= 100 &&
          request.resource.data.overrideReason is string &&
          request.resource.data.overrideReason.size() <= 500 &&
          (request.resource.data.loadWarnings.size() == 0 || request.resource.data.overrideReason.size() > 0) &&
          request.resource.data.revision is int && request.resource.data.revision > 0 &&
          request.resource.data.revisionKey is string &&
          request.resource.data.revisionKey.matches('^r-[0-9]{6,12}$') &&
          request.resource.data.publicationType in ['publish', 'restore'] &&
          request.resource.data.restoredFromRevisionKey is string &&
          ((request.resource.data.publicationType == 'publish' &&
            request.resource.data.restoredFromRevisionKey == '') ||
           (request.resource.data.publicationType == 'restore' &&
            request.resource.data.restoredFromRevisionKey.matches('^r-[0-9]{6,12}$'))) &&
          request.resource.data.schemaVersion == 1 &&
          request.resource.data.timeZone == 'Asia/Jerusalem' &&
          request.resource.data.createdAt is timestamp &&
          request.resource.data.createdBy is string &&
          request.resource.data.updatedAt == request.time &&
          request.resource.data.updatedBy == request.auth.uid;
      }

      function validDraftSchedule() {
        return request.resource.data.keys().hasAll([
            'eventId', 'teamIds', 'commanderNames', 'rows', 'loadPolicy',
            'loadWarnings', 'overrideReason', 'baseRevision', 'draftRevision',
            'schemaVersion', 'timeZone', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
          ]) &&
          request.resource.data.keys().hasOnly([
            'eventId', 'teamIds', 'commanderNames', 'rows', 'loadPolicy',
            'loadWarnings', 'overrideReason', 'baseRevision', 'draftRevision',
            'schemaVersion', 'timeZone', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
          ]) &&
          request.resource.data.eventId == eventId &&
          request.resource.data.teamIds is list && request.resource.data.teamIds.size() > 0 &&
          request.resource.data.teamIds.size() <= 15 &&
          request.resource.data.commanderNames is map && request.resource.data.commanderNames.size() <= 15 &&
          request.resource.data.rows is list && request.resource.data.rows.size() <= 100 &&
          request.resource.data.loadPolicy is map &&
          request.resource.data.loadPolicy.keys().hasAll([
            'windowMinutes', 'maxWindowLoad', 'highIntensity', 'maxConsecutiveHigh'
          ]) &&
          request.resource.data.loadPolicy.keys().hasOnly([
            'windowMinutes', 'maxWindowLoad', 'highIntensity', 'maxConsecutiveHigh'
          ]) &&
          request.resource.data.loadPolicy.windowMinutes is int &&
          request.resource.data.loadPolicy.windowMinutes >= 30 &&
          request.resource.data.loadPolicy.maxWindowLoad is int &&
          request.resource.data.loadPolicy.maxWindowLoad > 0 &&
          request.resource.data.loadPolicy.highIntensity is int &&
          request.resource.data.loadPolicy.highIntensity in [1, 2, 3] &&
          request.resource.data.loadPolicy.maxConsecutiveHigh is int &&
          request.resource.data.loadPolicy.maxConsecutiveHigh > 0 &&
          request.resource.data.loadWarnings is list && request.resource.data.loadWarnings.size() <= 100 &&
          request.resource.data.overrideReason is string &&
          request.resource.data.overrideReason.size() <= 500 &&
          (request.resource.data.loadWarnings.size() == 0 || request.resource.data.overrideReason.size() > 0) &&
          request.resource.data.baseRevision is int && request.resource.data.baseRevision >= 0 &&
          request.resource.data.draftRevision is int && request.resource.data.draftRevision > 0 &&
          request.resource.data.schemaVersion == 1 &&
          request.resource.data.timeZone == 'Asia/Jerusalem' &&
          request.resource.data.createdAt is timestamp &&
          request.resource.data.createdBy is string &&
          request.resource.data.updatedAt == request.time &&
          request.resource.data.updatedBy == request.auth.uid;
      }

      function mayManageSchedule() {
        return (isAdmin() || isFormationCommander()) && isActiveEvent(eventId);
      }

      function publishedRevisionAfter() {
        return existsAfter(/databases/$(database)/documents/events/$(eventId)/schedule/master)
          ? getAfter(/databases/$(database)/documents/events/$(eventId)/schedule/master).data.revision
          : 0;
      }

      function draftMatchesMasterAfter() {
        let master = getAfter(/databases/$(database)/documents/events/$(eventId)/schedule/master).data;
        let draft = getAfter(/databases/$(database)/documents/events/$(eventId)/schedule/draft).data;
        return draft.baseRevision == master.revision &&
          draft.teamIds == master.teamIds &&
          draft.commanderNames == master.commanderNames &&
          draft.rows == master.rows &&
          draft.loadPolicy == master.loadPolicy &&
          draft.loadWarnings == master.loadWarnings &&
          draft.overrideReason == master.overrideReason;
      }

      function validPublicationSource() {
        return request.resource.data.publicationType == 'publish' ||
          (request.resource.data.restoredFromRevisionKey != request.resource.data.revisionKey &&
           exists(/databases/$(database)/documents/events/$(eventId)/scheduleRevisions/$(request.resource.data.restoredFromRevisionKey)));
      }

      match /schedule/{scheduleId} {
        allow read: if scheduleId in ['master', 'draft'] && (isAdmin() || isFormationCommander());
        allow create: if scheduleId == 'master' && mayManageSchedule() &&
          validMasterSchedule() && request.resource.data.revision == 1 &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.createdBy == request.auth.uid &&
          validPublicationSource() &&
          draftMatchesMasterAfter() &&
          getAfter(/databases/$(database)/documents/events/$(eventId)/scheduleRevisions/$(request.resource.data.revisionKey)).data.revision ==
            request.resource.data.revision;
        allow update: if scheduleId == 'master' && mayManageSchedule() &&
          validMasterSchedule() &&
          request.resource.data.revision == resource.data.revision + 1 &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.createdBy == resource.data.createdBy &&
          validPublicationSource() &&
          draftMatchesMasterAfter() &&
          getAfter(/databases/$(database)/documents/events/$(eventId)/scheduleRevisions/$(request.resource.data.revisionKey)).data.revision ==
            request.resource.data.revision;
        allow create: if scheduleId == 'draft' && mayManageSchedule() &&
          validDraftSchedule() && request.resource.data.draftRevision == 1 &&
          request.resource.data.baseRevision == publishedRevisionAfter() &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.createdBy == request.auth.uid;
        allow update: if scheduleId == 'draft' && mayManageSchedule() &&
          validDraftSchedule() &&
          request.resource.data.draftRevision == resource.data.draftRevision + 1 &&
          request.resource.data.baseRevision == publishedRevisionAfter() &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.createdBy == resource.data.createdBy;
        allow delete: if false;
      }

      match /teamSchedules/{teamNumber} {
        function validTeamSchedule() {
          return request.resource.data.keys().hasAll([
              'eventId', 'team', 'commanderName', 'entries', 'sourceRevision',
              'schemaVersion', 'timeZone', 'updatedAt', 'updatedBy'
            ]) &&
            request.resource.data.keys().hasOnly([
              'eventId', 'team', 'commanderName', 'entries', 'sourceRevision',
              'schemaVersion', 'timeZone', 'updatedAt', 'updatedBy'
            ]) &&
            request.resource.data.eventId == eventId &&
            request.resource.data.team == teamNumber &&
            request.resource.data.commanderName is string &&
            request.resource.data.commanderName.size() <= 80 &&
            request.resource.data.entries is list && request.resource.data.entries.size() <= 100 &&
            request.resource.data.sourceRevision is int && request.resource.data.sourceRevision > 0 &&
            request.resource.data.schemaVersion == 1 &&
            request.resource.data.timeZone == 'Asia/Jerusalem' &&
            request.resource.data.updatedAt == request.time &&
            request.resource.data.updatedBy == request.auth.uid &&
            teamNumber in getAfter(/databases/$(database)/documents/events/$(eventId)/schedule/master).data.teamIds &&
            request.resource.data.sourceRevision ==
              getAfter(/databases/$(database)/documents/events/$(eventId)/schedule/master).data.revision;
        }

        allow read: if isAdmin() || isFormationCommander() ||
          ((isApprovedRole('operator') || isApprovedRole('evaluator')) && isOwnTeam(teamNumber));
        allow create, update: if mayManageSchedule() && validTeamSchedule();
        allow delete: if false;
      }

      // Every successful save appends the complete approved snapshot. Revisions
      // can be audited but never rewritten or removed.
      match /scheduleRevisions/{revisionId} {
        allow read: if isAdmin() || isFormationCommander();
        allow create: if mayManageSchedule() && validMasterSchedule() &&
          revisionId == request.resource.data.revisionKey &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.revision ==
            getAfter(/databases/$(database)/documents/events/$(eventId)/schedule/master).data.revision &&
          request.resource.data.teamIds ==
            getAfter(/databases/$(database)/documents/events/$(eventId)/schedule/master).data.teamIds &&
          request.resource.data.commanderNames ==
            getAfter(/databases/$(database)/documents/events/$(eventId)/schedule/master).data.commanderNames &&
          request.resource.data.rows ==
            getAfter(/databases/$(database)/documents/events/$(eventId)/schedule/master).data.rows &&
          request.resource.data.loadPolicy ==
            getAfter(/databases/$(database)/documents/events/$(eventId)/schedule/master).data.loadPolicy &&
          request.resource.data.loadWarnings ==
            getAfter(/databases/$(database)/documents/events/$(eventId)/schedule/master).data.loadWarnings &&
          request.resource.data.overrideReason ==
            getAfter(/databases/$(database)/documents/events/$(eventId)/schedule/master).data.overrideReason &&
          request.resource.data.revisionKey ==
            getAfter(/databases/$(database)/documents/events/$(eventId)/schedule/master).data.revisionKey &&
          request.resource.data.publicationType ==
            getAfter(/databases/$(database)/documents/events/$(eventId)/schedule/master).data.publicationType &&
          request.resource.data.restoredFromRevisionKey ==
            getAfter(/databases/$(database)/documents/events/$(eventId)/schedule/master).data.restoredFromRevisionKey;
        allow update, delete: if false;
      }

      match /candidates/{candidateId} {
        function validDropoutReason(reasonCode, reasonLabel) {
          return (reasonCode == 'voluntary' && reasonLabel == 'פרישה') ||
            (reasonCode == 'medical' && reasonLabel == 'רפואי') ||
            (reasonCode == 'dismissal' && reasonLabel == 'הדחה');
        }

        function validCandidateRecord() {
          return request.resource.data.keys().hasAll([
              'participantId', 'team', 'firstName', 'nationalId', 'emergencyContactPhone',
              'doctorClearance', 'medicClearance',
              'status', 'reasonCode', 'reasonLabel', 'statusRevision', 'profileRevision',
              'lastTransitionId', 'statusChangedAt', 'statusChangedBy',
              'profileUpdatedAt', 'profileUpdatedBy', 'schemaVersion'
            ]) &&
            request.resource.data.keys().hasOnly([
              'participantId', 'team', 'firstName', 'nationalId', 'emergencyContactPhone',
              'doctorClearance', 'medicClearance',
              'status', 'reasonCode', 'reasonLabel', 'statusRevision', 'profileRevision',
              'lastTransitionId', 'statusChangedAt', 'statusChangedBy',
              'profileUpdatedAt', 'profileUpdatedBy', 'schemaVersion'
            ]) &&
            request.resource.data.participantId is string &&
            request.resource.data.participantId.size() > 0 &&
            request.resource.data.participantId.size() <= 100 &&
            request.resource.data.participantId.matches('^[0-9]+$') &&
            request.resource.data.participantId != '0' &&
            request.resource.data.team is string &&
            candidateId == request.resource.data.team + '_' + request.resource.data.participantId &&
            request.resource.data.firstName is string &&
            request.resource.data.firstName.size() > 0 &&
            request.resource.data.firstName.size() <= 80 &&
            request.resource.data.firstName != '0' &&
            request.resource.data.nationalId is string &&
            request.resource.data.nationalId.matches('^[0-9]{9}$') &&
            request.resource.data.emergencyContactPhone is string &&
            request.resource.data.emergencyContactPhone.matches('^[0-9]{9,15}$') &&
            request.resource.data.doctorClearance is int &&
            request.resource.data.doctorClearance in [0, 1, 2] &&
            request.resource.data.medicClearance is int &&
            request.resource.data.medicClearance in [0, 1, 2] &&
            request.resource.data.status in ['active', 'withdrawn'] &&
            ((request.resource.data.status == 'withdrawn' &&
              validDropoutReason(request.resource.data.reasonCode, request.resource.data.reasonLabel)) ||
             (request.resource.data.status == 'active' &&
              request.resource.data.reasonCode == '' && request.resource.data.reasonLabel == '')) &&
            request.resource.data.statusRevision is int && request.resource.data.statusRevision >= 0 &&
            request.resource.data.profileRevision is int && request.resource.data.profileRevision >= 0 &&
            request.resource.data.lastTransitionId is string &&
            request.resource.data.statusChangedAt is timestamp &&
            request.resource.data.statusChangedBy is string &&
            request.resource.data.profileUpdatedAt is timestamp &&
            request.resource.data.profileUpdatedBy is string &&
            request.resource.data.schemaVersion == 3;
        }

        allow read: if isAdmin() || isFormationCommander() ||
          ((isApprovedRole('operator') || isApprovedRole('evaluator')) && isOwnTeam(resource.data.team));
        allow create: if isAdmin() && validCandidateRecord() &&
          request.resource.data.status == 'active' && request.resource.data.statusRevision == 0 &&
          request.resource.data.profileRevision == 0 && request.resource.data.lastTransitionId == '' &&
          request.resource.data.statusChangedAt == request.time &&
          request.resource.data.statusChangedBy == request.auth.uid &&
          request.resource.data.profileUpdatedAt == request.time &&
          request.resource.data.profileUpdatedBy == request.auth.uid;
        allow update: if (isAdmin() || isFormationCommander()) && validCandidateRecord() &&
          isActiveEvent(eventId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'reasonCode', 'reasonLabel', 'statusRevision', 'lastTransitionId',
            'statusChangedAt', 'statusChangedBy'
          ]) &&
          request.resource.data.statusRevision == resource.data.statusRevision + 1 &&
          request.resource.data.statusChangedAt == request.time &&
          request.resource.data.statusChangedBy == request.auth.uid &&
          request.resource.data.lastTransitionId.size() > 0 &&
          getAfter(/databases/$(database)/documents/events/$(eventId)/candidateStatusEvents/$(request.resource.data.lastTransitionId)).data.candidateKey == candidateId &&
          getAfter(/databases/$(database)/documents/events/$(eventId)/candidateStatusEvents/$(request.resource.data.lastTransitionId)).data.changedBy == request.auth.uid &&
          (request.resource.data.status != 'withdrawn' ||
           !exists(/databases/$(database)/documents/events/$(eventId)/dropoutRecommendations/$(candidateId)) ||
           get(/databases/$(database)/documents/events/$(eventId)/dropoutRecommendations/$(candidateId)).data.status != 'open' ||
           getAfter(/databases/$(database)/documents/events/$(eventId)/dropoutRecommendations/$(candidateId)).data.status == 'accepted');
        allow update: if isAdmin() && validCandidateRecord() && isActiveEvent(eventId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'firstName', 'nationalId', 'emergencyContactPhone',
            'doctorClearance', 'medicClearance',
            'profileRevision', 'profileUpdatedAt', 'profileUpdatedBy'
          ]) &&
          request.resource.data.profileRevision == resource.data.profileRevision + 1 &&
          request.resource.data.profileUpdatedAt == request.time &&
          request.resource.data.profileUpdatedBy == request.auth.uid;
        allow delete: if false;
      }

      match /dropoutRecommendations/{recommendationId} {
        function validDropoutReason(reasonCode, reasonLabel) {
          return (reasonCode == 'voluntary' && reasonLabel == 'פרישה') ||
            (reasonCode == 'medical' && reasonLabel == 'רפואי') ||
            (reasonCode == 'dismissal' && reasonLabel == 'הדחה');
        }

        function validRecommendationShape() {
          return request.resource.data.keys().hasAll([
              'participantId', 'team', 'reasonCode', 'reasonLabel', 'details', 'status',
              'recommendedBy', 'recommendedByName', 'revision', 'createdAt', 'updatedAt',
              'resolvedAt', 'resolvedBy', 'schemaVersion'
            ]) &&
            request.resource.data.keys().hasOnly([
              'participantId', 'team', 'reasonCode', 'reasonLabel', 'details', 'status',
              'recommendedBy', 'recommendedByName', 'revision', 'createdAt', 'updatedAt',
              'resolvedAt', 'resolvedBy', 'schemaVersion'
            ]) &&
            request.resource.data.participantId is string &&
            request.resource.data.participantId.size() > 0 &&
            request.resource.data.participantId.size() <= 100 &&
            request.resource.data.team is string &&
            recommendationId == request.resource.data.team + '_' + request.resource.data.participantId &&
            validDropoutReason(request.resource.data.reasonCode, request.resource.data.reasonLabel) &&
            request.resource.data.details is string && request.resource.data.details.size() <= 1000 &&
            request.resource.data.status in ['open', 'accepted', 'rejected', 'cancelled'] &&
            request.resource.data.recommendedBy is string &&
            request.resource.data.recommendedByName is string &&
            request.resource.data.recommendedByName.size() <= 200 &&
            request.resource.data.revision is int && request.resource.data.revision > 0 &&
            request.resource.data.schemaVersion == 1;
        }

        function isOwnOpenRecommendation() {
          return isApprovedRole('operator') && isOwnTeam(request.resource.data.team) &&
            request.resource.data.recommendedBy == request.auth.uid;
        }

        allow read: if isAdmin() || isFormationCommander() ||
          (isApprovedRole('operator') && isOwnTeam(resource.data.team));
        allow create: if validRecommendationShape() && isOwnOpenRecommendation() &&
          isActiveEvent(eventId) && request.resource.data.status == 'open' &&
          request.resource.data.revision == 1 &&
          request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time &&
          request.resource.data.resolvedAt == null && request.resource.data.resolvedBy == '' &&
          exists(/databases/$(database)/documents/events/$(eventId)/candidates/$(recommendationId)) &&
          get(/databases/$(database)/documents/events/$(eventId)/candidates/$(recommendationId)).data.status == 'active';

        // A team commander may edit their own open recommendation or open a new
        // recommendation after the previous one was resolved.
        allow update: if validRecommendationShape() && isOwnOpenRecommendation() &&
          isActiveEvent(eventId) && request.resource.data.revision == resource.data.revision + 1 &&
          request.resource.data.status == 'open' && request.resource.data.updatedAt == request.time &&
          request.resource.data.resolvedAt == null && request.resource.data.resolvedBy == '' &&
          ((resource.data.status == 'open' && resource.data.recommendedBy == request.auth.uid &&
            request.resource.data.createdAt == resource.data.createdAt) ||
           (resource.data.status in ['accepted', 'rejected', 'cancelled'] &&
            request.resource.data.createdAt == request.time)) &&
          exists(/databases/$(database)/documents/events/$(eventId)/candidates/$(recommendationId)) &&
          get(/databases/$(database)/documents/events/$(eventId)/candidates/$(recommendationId)).data.status == 'active';
        allow update: if isApprovedRole('operator') && validRecommendationShape() &&
          isOwnTeam(resource.data.team) && resource.data.status == 'open' &&
          resource.data.recommendedBy == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'revision', 'updatedAt', 'resolvedAt', 'resolvedBy'
          ]) && request.resource.data.status == 'cancelled' &&
          request.resource.data.revision == resource.data.revision + 1 &&
          request.resource.data.updatedAt == request.time &&
          request.resource.data.resolvedAt == request.time &&
          request.resource.data.resolvedBy == request.auth.uid;
        allow update: if (isAdmin() || isFormationCommander()) && validRecommendationShape() &&
          isActiveEvent(eventId) &&
          resource.data.status == 'open' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'revision', 'updatedAt', 'resolvedAt', 'resolvedBy'
          ]) && request.resource.data.status in ['accepted', 'rejected'] &&
          request.resource.data.revision == resource.data.revision + 1 &&
          request.resource.data.updatedAt == request.time &&
          request.resource.data.resolvedAt == request.time &&
          request.resource.data.resolvedBy == request.auth.uid &&
          (request.resource.data.status == 'rejected' ||
            (getAfter(/databases/$(database)/documents/events/$(eventId)/candidates/$(recommendationId)).data.status == 'withdrawn' &&
             getAfter(/databases/$(database)/documents/events/$(eventId)/candidates/$(recommendationId)).data.reasonCode == resource.data.reasonCode));
        allow delete: if false;
      }

      // Status transitions are appended to an immutable audit trail. The new
      // candidate state must be part of the same atomic transaction.
      match /candidateStatusEvents/{transitionId} {
        function validTransition() {
          return request.resource.data.keys().hasAll([
              'candidateKey', 'participantId', 'team', 'fromStatus', 'toStatus',
              'reasonCode', 'reasonLabel', 'details', 'source', 'recommendationId',
              'changedAt', 'changedBy', 'changedByName', 'schemaVersion'
            ]) &&
            request.resource.data.keys().hasOnly([
              'candidateKey', 'participantId', 'team', 'fromStatus', 'toStatus',
              'reasonCode', 'reasonLabel', 'details', 'source', 'recommendationId',
              'changedAt', 'changedBy', 'changedByName', 'schemaVersion'
            ]) &&
            request.resource.data.participantId is string &&
            request.resource.data.participantId.size() > 0 &&
            request.resource.data.participantId.size() <= 100 &&
            request.resource.data.team is string &&
            request.resource.data.candidateKey == request.resource.data.team + '_' + request.resource.data.participantId &&
            request.resource.data.fromStatus in ['active', 'withdrawn'] &&
            request.resource.data.toStatus in ['active', 'withdrawn'] &&
            request.resource.data.details is string && request.resource.data.details.size() <= 1000 &&
            request.resource.data.source in ['direct', 'recommendation'] &&
            request.resource.data.recommendationId is string &&
            request.resource.data.changedAt == request.time &&
            request.resource.data.changedBy == request.auth.uid &&
            request.resource.data.changedByName is string &&
            request.resource.data.changedByName.size() <= 200 &&
            request.resource.data.schemaVersion == 1 &&
            get(/databases/$(database)/documents/events/$(eventId)/candidates/$(request.resource.data.candidateKey)).data.status == request.resource.data.fromStatus &&
            getAfter(/databases/$(database)/documents/events/$(eventId)/candidates/$(request.resource.data.candidateKey)).data.status == request.resource.data.toStatus &&
            getAfter(/databases/$(database)/documents/events/$(eventId)/candidates/$(request.resource.data.candidateKey)).data.statusChangedBy == request.auth.uid &&
            getAfter(/databases/$(database)/documents/events/$(eventId)/candidates/$(request.resource.data.candidateKey)).data.lastTransitionId == transitionId &&
            getAfter(/databases/$(database)/documents/events/$(eventId)/candidates/$(request.resource.data.candidateKey)).data.reasonCode == request.resource.data.reasonCode &&
            getAfter(/databases/$(database)/documents/events/$(eventId)/candidates/$(request.resource.data.candidateKey)).data.reasonLabel == request.resource.data.reasonLabel;
        }

        allow read: if isAdmin() || isFormationCommander();
        allow create: if (isAdmin() || isFormationCommander()) &&
          isActiveEvent(eventId) && validTransition();
        allow update, delete: if false;
      }
    }

    // Teams (participants + station mapping): team members read, admins write.
    match /teams/{teamNumber} {
      allow read: if isAdmin() ||
        (signedIn() && caller().approved == true && int(teamNumber) == int(caller().team));
      allow write: if isAdmin();
    }

    // Shared station types and quick-comment settings.
    match /settings/{key} {
      allow read: if signedIn() && (caller().approved == true || isAdmin());
      allow write: if isAdmin();
    }

    // Legacy shared notes remain available only until the administrator completes
    // the migration. New notes are isolated under authors/{uid}.
    match /general_notes/{noteId} {
      allow read: if isAdmin() || (!privacyMigrationComplete() &&
        signedIn() && caller().approved == true &&
        int(noteId.split('_')[0]) == int(caller().team));
      allow write: if isAdmin();
      allow create: if !privacyMigrationComplete() &&
        signedIn() && caller().approved == true &&
        caller().role in ['operator', 'evaluator'] &&
        int(noteId.split('_')[0]) == int(caller().team);
      allow update, delete: if !privacyMigrationComplete() &&
        signedIn() && caller().approved == true &&
        caller().role in ['operator', 'evaluator'] &&
        (!resource.data.keys().hasAny(['privacySchemaVersion']) ||
          resource.data.privacySchemaVersion != 2) &&
        int(noteId.split('_')[0]) == int(caller().team);

      match /authors/{authorUid} {
        function ownsPrivateNotes() {
          return signedIn() && request.auth.uid == authorUid &&
            caller().approved == true && caller().role in ['operator', 'evaluator'] &&
            int(noteId.split('_')[0]) == int(caller().team);
        }

        function validPrivateNotesShape() {
          return request.resource.data.keys().hasAll([
              'authorUid', 'team', 'participantId', 'notes',
              'schemaVersion', 'createdAt', 'updatedAt'
            ]) &&
            request.resource.data.keys().hasOnly([
              'authorUid', 'team', 'participantId', 'notes',
              'schemaVersion', 'createdAt', 'updatedAt'
            ]) &&
            request.resource.data.authorUid == authorUid &&
            int(request.resource.data.team) == int(noteId.split('_')[0]) &&
            request.resource.data.participantId == noteId.split('_')[1] &&
            request.resource.data.notes is list &&
            request.resource.data.notes.size() <= 200 &&
            request.resource.data.schemaVersion == 2 &&
            request.resource.data.updatedAt == request.time;
        }

        allow read: if isAdmin() || ownsPrivateNotes();
        allow create: if isAdmin() ||
          (ownsPrivateNotes() && validPrivateNotesShape() &&
           request.resource.data.createdAt == request.time);
        allow update: if isAdmin() ||
          (ownsPrivateNotes() && validPrivateNotesShape() &&
           request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['notes', 'updatedAt']));
        allow delete: if isAdmin();
      }
    }

    // Immutable source copies created by the administrator before stripping
    // legacy shared fields. They are never exposed to operational users.
    match /privacy_migration_archive/{archiveId} {
      allow read, create, update: if isAdmin();
      allow delete: if false;
    }

    // Operational issue reports contain only an allow-listed diagnostic context.
    // Reporters may create a report but cannot read or alter reports afterward.
    // The formation commander can monitor active-event reports; administrators
    // alone own triage and status updates.
    match /issue_reports/{reportId} {
      function validIssueContext() {
        return request.resource.data.context is map &&
          request.resource.data.context.keys().hasAll([
            'team', 'station', 'stationType', 'stationName', 'viewedRaceId',
            'latestRaceId', 'round', 'raceStatus', 'effectiveElapsedMs', 'historicalView'
          ]) &&
          request.resource.data.context.keys().hasOnly([
            'team', 'station', 'stationType', 'stationName', 'viewedRaceId',
            'latestRaceId', 'round', 'raceStatus', 'effectiveElapsedMs', 'historicalView'
          ]) &&
          request.resource.data.context.team is string &&
          request.resource.data.context.team.size() <= 200 &&
          request.resource.data.context.station is string &&
          request.resource.data.context.station.size() <= 200 &&
          request.resource.data.context.stationType is string &&
          request.resource.data.context.stationType.size() <= 200 &&
          request.resource.data.context.stationName is string &&
          request.resource.data.context.stationName.size() <= 200 &&
          request.resource.data.context.viewedRaceId is string &&
          request.resource.data.context.viewedRaceId.size() <= 200 &&
          request.resource.data.context.latestRaceId is string &&
          request.resource.data.context.latestRaceId.size() <= 200 &&
          request.resource.data.context.round is int &&
          request.resource.data.context.round >= 0 &&
          request.resource.data.context.raceStatus in ['not_started', 'running', 'stopped', 'time_limit'] &&
          request.resource.data.context.effectiveElapsedMs is int &&
          request.resource.data.context.effectiveElapsedMs >= 0 &&
          request.resource.data.context.effectiveElapsedMs <= 2400000 &&
          request.resource.data.context.historicalView is bool;
      }

      function validIssueEnvironment() {
        return request.resource.data.environment is map &&
          request.resource.data.environment.keys()
            .hasAll(['appVersion', 'online', 'viewport', 'userAgent']) &&
          request.resource.data.environment.keys()
            .hasOnly(['appVersion', 'online', 'viewport', 'userAgent']) &&
          request.resource.data.environment.appVersion is string &&
          request.resource.data.environment.appVersion.size() <= 100 &&
          request.resource.data.environment.online is bool &&
          request.resource.data.environment.viewport is string &&
          request.resource.data.environment.viewport.size() <= 50 &&
          request.resource.data.environment.userAgent is string &&
          request.resource.data.environment.userAgent.size() <= 500;
      }

      function validNewIssueReport() {
        return request.resource.data.keys().hasAll([
            'eventId', 'reporterUid', 'reporterName', 'reporterRole', 'reporterTeam',
            'category', 'description', 'steps', 'status', 'adminNote',
            'context', 'environment', 'schemaVersion', 'createdAt', 'updatedAt'
          ]) &&
          request.resource.data.keys().hasOnly([
            'eventId', 'reporterUid', 'reporterName', 'reporterRole', 'reporterTeam',
            'category', 'description', 'steps', 'status', 'adminNote',
            'context', 'environment', 'schemaVersion', 'createdAt', 'updatedAt'
          ]) &&
          request.resource.data.eventId is string &&
          request.resource.data.eventId.size() > 0 &&
          request.resource.data.eventId.size() <= 128 &&
          isActiveEvent(request.resource.data.eventId) &&
          request.resource.data.reporterUid == request.auth.uid &&
          request.resource.data.reporterName is string &&
          request.resource.data.reporterName.size() <= 200 &&
          request.resource.data.reporterRole == caller().role &&
          request.resource.data.reporterRole in ['operator', 'evaluator', 'admin'] &&
          request.resource.data.reporterTeam is int &&
          request.resource.data.reporterTeam >= 1 && request.resource.data.reporterTeam <= 15 &&
          (isAdmin() || request.resource.data.reporterTeam == int(caller().team)) &&
          request.resource.data.category in ['timing', 'arrival_order', 'saving', 'display', 'other'] &&
          request.resource.data.description is string &&
          request.resource.data.description.size() > 0 &&
          request.resource.data.description.size() <= 2000 &&
          request.resource.data.steps is string && request.resource.data.steps.size() <= 2000 &&
          request.resource.data.status == 'open' &&
          request.resource.data.adminNote == '' &&
          request.resource.data.schemaVersion == 2 &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.updatedAt == request.time &&
          validIssueContext() && validIssueEnvironment();
      }

      allow create: if signedIn() &&
        (isAdmin() || (caller().approved == true && caller().role in ['operator', 'evaluator'])) &&
        validNewIssueReport();
      allow read: if isAdmin() ||
        (isFormationCommander() && resource.data.schemaVersion == 2 &&
         resource.data.eventId is string && isActiveEvent(resource.data.eventId));
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'adminNote', 'updatedAt', 'handledAt', 'handledBy']) &&
        request.resource.data.status in ['open', 'in_progress', 'resolved'] &&
        request.resource.data.adminNote is string &&
        request.resource.data.adminNote.size() <= 2000 &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.handledAt == request.time &&
        request.resource.data.handledBy == request.auth.uid;
      allow delete: if isAdmin();
    }
  }
}
